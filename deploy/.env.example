# Docker Compose configuration. Copy to deploy/.env and fill in.

# ---- Required ----
# Database password: openssl rand -hex 24
# (letters and digits only, so it needs no escaping in the connection URL)
POSTGRES_PASSWORD=
# Session secret: leave empty to have one generated and kept in the data volume, or: openssl rand -hex 32
SESSION_SECRET=

# External address (the HTTPS URL of your reverse proxy / tunnel). Also the OAuth issuer.
PUBLIC_URL=http://localhost:8787
# Published port. Binds to localhost by default; put a reverse proxy in front,
# or set TEXDRAFT_BIND=0.0.0.0 to expose it directly.
TEXDRAFT_BIND=127.0.0.1
TEXDRAFT_PORT=8787

# Initial registration mode: open | invite | closed. The first account becomes an administrator;
# admins can change the mode later in the Admin page.
REGISTRATION=invite
# ADMIN_EMAILS=you@example.com

# ---- AI ----
ANTHROPIC_API_KEY=
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TOKENS=64000
AGENT_EFFORT=high
# Anthropic-compatible endpoint (e.g. DeepSeek):
#   AGENT_PROVIDER=compatible
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   AGENT_MODEL=deepseek-chat
#   AGENT_MAX_TOKENS=8192

# Who may use the key above: all | admins | none (users can add their own key in Account settings)
AI_SHARED_KEY=all
# Daily token allowance per user on the server key (0 = unlimited)
AI_SHARED_DAILY_TOKENS=0
# Total credit per user on the server key, in AI_CURRENCY (0 = unlimited; admins exempt)
AI_SHARED_CREDIT=0
# Prices per million tokens used to charge the credit (uncached input / cached input / output)
# AI_PRICE_INPUT=2
# AI_PRICE_CACHED=0.04
# AI_PRICE_OUTPUT=8
# AI_CURRENCY=¥

# Public demo (a server open to strangers): quotas, sign-up limits, compile rate limits;
# disables server-side CLI agents and custom model endpoints. See ../.env.example for every option.
# PUBLIC_DEMO=true
# SOURCE_URL=https://github.com/<you>/texdraft
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ChatGPT / Claude connectors: by default the server fetches the client's metadata from
# chatgpt.com / claude.ai. Those sites often block data-center IPs with a bot check (HTTP 403);
# leave this empty so clients register dynamically instead:
# OAUTH_CIMD_HOSTS=

# Outbound proxy, if needed (AI API, reference search):
# https_proxy=http://host.docker.internal:7890
# NODE_USE_ENV_PROXY=1
