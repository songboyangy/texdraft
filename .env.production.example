# Production overrides for scripts/prod.sh: it loads .env first, then this file.
# Copy to .env.production (ignored by git) and fill in.

NODE_ENV=production
# Serve the web app and the API on one port
SERVE_WEB=1
PORT=8787
# 127.0.0.1: reachable only through the tunnel / a reverse proxy; 0.0.0.0: also on the LAN
HOST=0.0.0.0
LOG_LEVEL=info

# Public HTTPS address (e.g. the hostname configured in Cloudflare)
PUBLIC_URL=https://tex.example.com
# Require compile isolation when others can sign in; remove for a single-user setup
COMPILE_SANDBOX=bwrap
# Leave empty to have one generated in DATA_DIR/session-secret, or set: openssl rand -hex 32
SESSION_SECRET=

# Cloudflare Zero Trust → Networks → Tunnels → create a tunnel and copy its token;
# point the public hostname at http://127.0.0.1:8787. Leave empty to not start a tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
# Or keep the token in a file (mode 600); takes precedence over the variable above
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/home/you/.config/texdraft-tunnel/token
# Tunnel protocol: auto (default, falls back from QUIC to HTTP/2) | quic | http2
# Where UDP to Cloudflare is lossy (e.g. mainland China) http2 is usually much faster for uploads.
# CLOUDFLARED_PROTOCOL=auto
# Path to cloudflared (default: cloudflared on PATH, else ~/bin/cloudflared)
# CLOUDFLARED_BIN=
