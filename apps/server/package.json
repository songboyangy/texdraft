{
  "name": "@texdraft/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
