    "@fastify/websocket": "^11.3.6",
    "@hocuspocus/extension-database": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "@texdraft/shared": "workspace:^",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "pdfjs-dist": "6.5.438",
    "picomatch": "^4.0.7",
    "postgres": "^4.0.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
