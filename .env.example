# TeXdraft configuration. Copy to .env and adjust. See README.md#configuration.

# ---- Server ----
PORT=8787
# HOST=127.0.0.1
DATABASE_URL=postgres://texdraft@127.0.0.1:5433/texdraft
# Signs session cookies (and encrypts stored API keys unless AI_KEYS_SECRET is set).
# Leave empty to have a random one generated on first start and saved to DATA_DIR/session-secret,
# or set your own: openssl rand -hex 32
SESSION_SECRET=
# Uploaded files, compile workspaces and PDFs
DATA_DIR=./data
# External URL. On a public deployment set the HTTPS address: it is shown to MCP clients
# and is the OAuth issuer when ChatGPT / Claude.ai connect.
# PUBLIC_URL=http://127.0.0.1:8787
# 换域名后，旧主机名（逗号分隔）永久跳转到 PUBLIC_URL
# REDIRECT_HOSTS=
# 1 = serve the built web app (apps/web/dist) from this server
# SERVE_WEB=1

# ---- Accounts ----
# Initial registration mode: open | invite | closed. The first account becomes an
# administrator; admins can change the mode and create invite links in the Admin page.
# REGISTRATION=open
# Comma-separated emails that become administrators when they register or sign in
# ADMIN_EMAILS=

# ---- Compiling ----
# local-tectonic: tectonic on this machine (downloads packages on demand)
# local-latexmk:  TeX Live + latexmk on this machine
# docker:         TeX Live in a fresh container per compile (no network, read-only, resource limits)
COMPILE_RUNNER=local-tectonic
COMPILE_TIMEOUT_MS=90000
COMPILE_DOCKER_IMAGE=texlive/texlive:latest
# Isolation for the local-* runners. LaTeX can read any file the compiler can read (e.g. this one).
#   auto  (default) bubblewrap if usable, else the unprivileged-user mode, else run unisolated with a warning
#   bwrap require bubblewrap; refuse to compile without it (recommended when others can sign in)
#   uid   server runs as root and compiles as COMPILE_UID / COMPILE_GID (used by the Docker image)
#   none  no isolation (single-user setups only)
# bubblewrap needs unprivileged user namespaces; it is not available inside containers with the
# default seccomp profile (use the Docker image's uid mode or COMPILE_RUNNER=docker there).
# COMPILE_SANDBOX=auto
# Extra read-only paths to mount into the bubblewrap sandbox (colon-separated), e.g. a custom TeX Live
# COMPILE_SANDBOX_RO_PATHS=
# Path to tectonic if it is not on PATH
# TECTONIC_BIN=/path/to/tectonic

# ---- AI ----
# anthropic  = Claude API (adaptive thinking, progress updates, prompt caching, refusal fallback)
# compatible = any Anthropic-compatible endpoint (e.g. DeepSeek); only standard fields are sent
# openai     = any OpenAI Chat Completions-compatible endpoint (OpenAI, Gemini, Qwen, Kimi, GLM,
#              OpenRouter, Ollama, vLLM …)
AGENT_PROVIDER=anthropic
# Credentials: AGENT_API_KEY / AGENT_BASE_URL apply to any provider; otherwise ANTHROPIC_* is used for
# anthropic / compatible and OPENAI_* for openai (default base URL https://api.openai.com/v1)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TOKENS=64000
AGENT_EFFORT=high
AGENT_MAX_STEPS=40
# Claude API only; set false for gateways that reject beta parameters
AGENT_BETA_FEATURES=true
# Whether the model can look at images returned by tools (rendered PDF pages).
# auto = yes for the Claude API and api.openai.com, no for other compatible endpoints
# AGENT_VISION=auto
# Context window in tokens (default 200000 for Claude, 128000 otherwise)
# AGENT_CONTEXT_WINDOW=
# Long conversations are compacted when the context passes this share of the window:
# first older tool outputs are cleared, then earlier turns are summarized by the model
# AGENT_COMPACT_AT=0.75
# Examples:
#   DeepSeek:  AGENT_PROVIDER=compatible ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic AGENT_MODEL=deepseek-chat AGENT_MAX_TOKENS=8192
#   OpenAI:    AGENT_PROVIDER=openai OPENAI_API_KEY=sk-... AGENT_MODEL=gpt-5
#   Qwen:      AGENT_PROVIDER=openai OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 AGENT_MODEL=qwen-plus
#   Ollama:    AGENT_PROVIDER=openai OPENAI_BASE_URL=http://127.0.0.1:11434/v1 OPENAI_API_KEY=ollama AGENT_MODEL=qwen3

# ---- Per-user AI keys ----
# Users can add their own provider and API key in Account settings (stored AES-256-GCM encrypted).
# Who may use the server's key above: all | admins | none (everyone must bring a key)
# AI_SHARED_KEY=all
# Daily token allowance per user on the server's key (0 = unlimited)
# AI_SHARED_DAILY_TOKENS=0
# Total credit per user on the server's key, in AI_CURRENCY (0 = unlimited; admins are exempt and can adjust it per user)
# AI_SHARED_CREDIT=1
# Server-model prices per million tokens, used to charge that credit (defaults: DeepSeek Flash peak rates, CNY)
# AI_PRICE_INPUT=2
# AI_PRICE_CACHED=0.04
# AI_PRICE_OUTPUT=8
# AI_CURRENCY=¥
# Who may enter a custom endpoint URL: admins | all (public https only) | none
# AI_CUSTOM_BASE_URL=admins
# Secret used to encrypt stored keys (defaults to SESSION_SECRET; changing it invalidates saved keys)
# AI_KEYS_SECRET=

# Server plugins loaded at startup: comma-separated package names or file paths
# (see docs/plugins.md). Empty = none.
# TEXDRAFT_PLUGINS=

# ---- MCP / OAuth ----
# Hosts allowed to serve OAuth Client ID Metadata Documents (fetched by the server; SSRF guard)
# OAUTH_CIMD_HOSTS=chatgpt.com,claude.ai
# Single-user servers only: let the web UI configure and run the server's own
# Claude Code / Codex / Gemini CLI (writes to the server user's CLI config)
# ALLOW_LOCAL_AGENT_SETUP=false

# ---- Network ----
# Outbound proxy (tectonic package downloads, AI API, reference search)
# https_proxy=http://127.0.0.1:7890
# NODE_USE_ENV_PROXY=1
# NO_PROXY=127.0.0.1,localhost

# ---- Public demo / hosted instance ------------------------------------------
# PUBLIC_DEMO=true turns on conservative defaults for a server open to strangers
# (each value below can still be overridden) and always disables server-side CLI
# agents (ALLOW_LOCAL_AGENT_SETUP) and custom model endpoints (AI_CUSTOM_BASE_URL).
# PUBLIC_DEMO=false
# Source code link shown in the footer / user menu (AGPL: offer the source to network users)
# SOURCE_URL=https://github.com/<you>/texdraft
# Floating notice: "default" shows the built-in demo notice, "off" hides it, any other text is shown as is
# DEMO_NOTICE=default
# Product page at / for signed-out visitors (default: on with PUBLIC_DEMO, off otherwise)
# LANDING_PAGE=false

# ---- Reference search ------------------------------------------------------
# Crossref, arXiv and OpenAlex need no keys. An OpenAlex API key or contact email raises its rate limits.
# OPENALEX_API_KEY=
# OPENALEX_EMAIL=
# Cloudflare Turnstile on sign-up (both keys required)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Quotas (0 = unlimited; admins are exempt from the per-user ones). Defaults shown are for PUBLIC_DEMO=true.
# MAX_PROJECTS_PER_USER=20
# MAX_PROJECT_BYTES=104857600
# REGISTRATIONS_PER_IP_PER_DAY=3
# COMPILES_PER_MINUTE=10
# Concurrent compiles; extra requests queue (default: number of CPU cores, in every mode)
# COMPILE_CONCURRENCY=
